DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Ít nhất 32 ký tự ngẫu nhiên: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string
PORT=3001
# Domain của frontend, nhiều domain thì cách nhau bằng dấu phẩy
CLIENT_ORIGIN=http://localhost:5173
# Mật khẩu tài khoản admin: ít nhất 12 ký tự, có chữ hoa, chữ thường, số, ký tự đặc biệt, không chứa "admin".
# Bắt buộc khi NODE_ENV=production (thiếu hoặc yếu thì server không khởi động). Khi chạy dev có thể bỏ trống:
# admin đã có thì giữ mật khẩu cũ, chưa có thì server tạo mật khẩu ngẫu nhiên và in ra log một lần.
# Đổi giá trị này rồi khởi động lại là đổi mật khẩu admin và thu hồi mọi phiên đăng nhập cũ của admin.
ADMIN_PASSWORD=
